# Buddy App Environment Variables
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to GitHub or source control!

# Supabase Free-Tier Configuration (Option A - Free Postgres + Auth + Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Firebase Free-Tier Configuration (Option B - Firestore + Firebase Auth)
FIREBASE_API_KEY=AIzaSyDummyKeyForBuddyPlatform123456789
FIREBASE_APP_ID_WEB=1:1234567890:web:abcdef123456
FIREBASE_APP_ID_ANDROID=1:1234567890:android:abcdef123456
FIREBASE_PROJECT_ID=buddy-app-free
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_STORAGE_BUCKET=buddy-app-free.appspot.com

# Google OAuth Web Client ID (for Google Sign-In)
GOOGLE_WEB_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# App Configuration
APP_ENV=development
APP_NAME=Buddy
ENABLE_MOCK_FALLBACK=true
